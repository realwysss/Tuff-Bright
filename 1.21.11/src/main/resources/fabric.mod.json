{
	"schemaVersion": 1,
	"id": "tuffbright",
	"version": "${version}",
	"name": "Tuff Bright",
	"description": "fullbright that actually works: every block fully lit, no darkness effect, strength slider and /tuffbright command. menu needs Wysss Library (key C).",
	"authors": ["realwysss"],
	"contact": {"sources": "https://github.com/realwysss/Tuff-Bright"},
	"license": "All-Rights-Reserved",
	"icon": "assets/tuffbright/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.tfbr.TfbrClient"],
		"modmenu": ["dev.tfbr.ModmenuIntgr"]
	},
	"mixins": [
		{
			"config": "tuffbright.client.mixins.json",
			"environment": "client"
		}
	],
	"suggests": {
		"modmenu": "*",
		"wysslib": "*"
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"fabric-api": "*",
		"minecraft": ">=1.21.11 <1.22",
		"java": ">=21"
	}
}
